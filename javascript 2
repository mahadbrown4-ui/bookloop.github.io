// Example usage: getBooksAlphabetical('adult_coloring')async function gradeSubmission(submissionId, userId, scorePercentage, statusText, adminNotes) {
  // 1. Update the submission grade status
  const { error: submissionError } = await supabase
    .from('submissions')
    .update({ 
      quiz_score_percentage: scorePercentage,
      status: statusText,
      admin_notes: adminNotes
    })
    .eq('id', submissionId)

  if (submissionError) return console.error(submissionError)

  // 2. If score is 70% or higher and approved, trigger the $0.50 payout
  if (scorePercentage >= 70 && statusText === 'approved') {
    
    // Fetch user's current balance
    const { data: profile } = await supabase
      .from('profiles')
      .select('balance, membership_tier')
      .eq('id', userId)
      .single()

    // Ensure they have an active paid membership before paying them
    if (profile && profile.membership_tier !== 'free') {
      const newBalance = parseFloat(profile.balance) + 0.50

      await supabase
        .from('profiles')
        .update({ balance: newBalance })
        .eq('id', userId)
        
      alert(`Submission graded! User rewarded $0.50. New Balance: $${newBalance}`)
    }
  }
}
