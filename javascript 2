import { createClient } from '@supabase/supabase-js'

const supabaseUrl = 'https://your-project-url.supabase.co'
const supabaseKey = 'your-anonymous-public-key'
export const supabase = createClient(supabaseUrl, supabaseKey) // Sign In Feature
async function handleSignIn(email, password) {
  const { data, error } = await supabase.auth.signInWithPassword({
    email: email,
    password: password,
  })
  
  if (error) {
    console.error("Login failed:", error.message)
    alert(error.message)
  } else {
    window.location.href = "/dashboard" // Redirect to Hub dashboard
  }
}

// Create Account Feature
async function handleSignUp(email, password, fullName) {
  const { data, error } = await supabase.auth.signUp({
    email: email,
    password: password,
    options: {
      data: { full_name: fullName }
    }
  })

  if (error) alert(error.message)
  else alert("Check your email for the confirmation link!")
}// Get all books sorted from A to Z
async function getBooksAlphabetical(categoryFilter = null) {
  let query = supabase
    .from('books')
    .select('*')
    .order('title', { ascending: true }) // <--- Keeps it A to Z

  // Optional filtering for categories
  if (categoryFilter) {
    query = query.eq('category', categoryFilter)
  }

  const { data, error } = await query
  if (error) console.error(error)
  return data
}

